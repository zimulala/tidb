{
  "schema_version": "v1",
  "tools": [
    {
      "name": "sync_skills",
      "entry": "ai/ai-change-gates/tools/sync_skills.sh",
      "inputs": [
        "ai/skills_src/*/SPEC.yaml",
        "ai/skills_src/*/BODY.md"
      ],
      "outputs": [
        "~/.codex/skills/<install_name-or-skill>/SKILL.md",
        "~/.cursor/skills/<install_name-or-skill>/skill.md"
      ],
      "offline": true
    },
    {
      "name": "check_trust",
      "entry": "ai/ai-change-gates/tools/check_trust.sh",
      "inputs": [
        "repo-root ai.trust or .ai/trust",
        "~/.config/ai-change-gates/trusted_roots",
        "~/.config/ai-change-gates/trust.json"
      ],
      "outputs": [
        "stdout trust decision"
      ],
      "offline": true
    },
    {
      "name": "install_wt",
      "entry": "ai/ai-change-gates/tools/install_wt.sh",
      "inputs": [
        "ai/ai-change-gates/tools/wt/wt"
      ],
      "outputs": [
        "~/workspace/bin/wt symlink"
      ],
      "offline": true
    },
    {
      "name": "run_record",
      "entry": "ai/ai-change-gates/tools/run_record.sh",
      "inputs": [
        "--ssot <project>/PROJECT_STATE.md",
        "--mode navigate|navigate_patch",
        "--trigger manual|ci|local",
        "--read-file <path> (repeat)",
        "--next-action <text> (max 3)"
      ],
      "outputs": [
        "ai/ai-change-gates/runs/YYYY-MM-DD_run-<run_id>.json",
        "ai/ai-change-gates/runs/YYYY-MM-DD_run-<run_id>.md",
        "updated PROJECT_STATE.md last_run pointer"
      ],
      "safety": {
        "forbidden": [
          "source code edits",
          "build/config edits",
          "network bootstrap",
          "git push"
        ]
      },
      "offline": true
    },
    {
      "name": "quick_gatecheck",
      "entry": "ai/ai-change-gates/gatecheck/quick.sh",
      "inputs": [
        "ai/ai-change-gates/contracts/fail_codes.json",
        "ai/ai-change-gates/contracts/run_record.schema.json",
        "ai/ai-change-gates/skills.index.json",
        "ai/ai-change-gates/templates/run_record.template.json",
        "ai/ai-change-gates/tools.index.json",
        "ai/projects/topru-ai/PROJECT_STATE.md"
      ],
      "outputs": [
        "stdout gate summary"
      ],
      "offline": true
    },
    {
      "name": "wt",
      "entry": "ai/ai-change-gates/tools/wt/wt",
      "inputs": [
        "~/.config/wt/config",
        "command: open <branch> | pr <prNum>",
        "flags: --codex --cursor --dry-run -v"
      ],
      "outputs": [
        "git worktree created/updated under WT_ROOT",
        "optional codex/cursor launch",
        "dry-run command preview"
      ],
      "safety": {
        "requires_config": [
          "REPO_ROOT",
          "DEFAULT_REMOTE",
          "BASE_BRANCH",
          "CURSOR_CMD",
          "CODEX_CMD"
        ],
        "dry_run_supported": true,
        "pr_requires_gh": true
      },
      "offline": true
    },
    {
      "name": "pr_followup",
      "entry": "ai/ai-change-gates/tools/pr_followup.sh",
      "inputs": [
        "--pr <number>",
        "--mode <plan|exec>",
        "--reviewer <user> (optional)",
        "--out <dir> (optional)",
        "--include-resolved=1 (optional)",
        "--apply (exec only)"
      ],
      "outputs": [
        "ai/artifacts/pr_followup/<RUN_ID>/comments.raw.json",
        "ai/artifacts/pr_followup/<RUN_ID>/comments.json",
        "ai/artifacts/pr_followup/<RUN_ID>/comments.md",
        "ai/artifacts/pr_followup/<RUN_ID>/comment_actions.yaml",
        "ai/artifacts/pr_followup/<RUN_ID>/reply_draft.md",
        "ai/artifacts/pr_followup/<RUN_ID>/trace.jsonl",
        "ai/artifacts/pr_followup/<RUN_ID>/manifest.json",
        "ai/artifacts/pr_followup/<RUN_ID>/result.json",
        "ai/artifacts/pr_followup/<RUN_ID>/patch.diff (exec)",
        "ai/artifacts/pr_followup/<RUN_ID>/verify.log (exec)",
        "ai/artifacts/pr_followup/<RUN_ID>/touched_files.txt (exec)"
      ],
      "safety": {
        "forbidden": [
          "git push",
          "git config mutation",
          "curl|bash",
          "rm -rf /"
        ],
        "default_apply": false
      },
      "offline": false
    }
  ]
}
