#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
CONFIG_FILE="${WT_CONFIG:-${HOME}/.config/wt/config}"
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

VERBOSE=0
DRY_RUN=0
WANT_CODEX=0
WANT_CURSOR=0
WANT_REVIEW=0
REVIEW_FLAG_EXPLICIT=0
WANT_CODEX_PLAN=0
BASE_OVERRIDE=""
WT_INVOCATION=""
DECONFLICT_PUSH=0
DECONFLICT_NO_FALLBACK=0
DECONFLICT_HEAD_OWNER=""
DECONFLICT_HEAD_REPO=""
DECONFLICT_STRATEGY=""
DECONFLICT_DEFAULT_HEAD_OWNER="ti-chi-bot"

DECONFLICT_PR_URL=""
DECONFLICT_PR_TITLE=""
DECONFLICT_PR_NUMBER=""
DECONFLICT_BASE_REF=""
DECONFLICT_HEAD_REF=""
DECONFLICT_META_HEAD_REPO=""
DECONFLICT_META_HEAD_OWNER=""
DECONFLICT_EFFECTIVE_HEAD_REPO=""
DECONFLICT_EFFECTIVE_HEAD_OWNER=""
DECONFLICT_HEAD_REMOTE_URL=""
DECONFLICT_PR_META_RAW=""
DECONFLICT_PR_BODY=""
DECONFLICT_META_STATUS="not-run"
DECONFLICT_INTENT_STATUS="not-run"
DECONFLICT_WARNINGS=""

DECONFLICT_MARKER_SCAN_FILE=""
DECONFLICT_MARKER_LINE_COUNT=0
DECONFLICT_MARKER_FILE_COUNT=0
DECONFLICT_MARKER_SCAN_STATUS="not-run"

REVIEW_ART_DIR=""
REVIEW_RESULT_FILE=""
REVIEW_MANIFEST_FILE=""
REVIEW_TRACE_FILE=""
REVIEW_PR_SUMMARY_FILE=""
REVIEW_STRATEGY_FILE=""
REVIEW_RISK_SCAN_FILE=""
REVIEW_TEST_PLAN_FILE=""
REVIEW_NEXT_FILE=""
REVIEW_LLM_REVIEW_FILE=""
REVIEW_FINDINGS_FILE=""
REVIEW_STATUS="FAIL"
REVIEW_MIN_TESTS_HINT=""

REPO_ROOT=""
DEFAULT_REMOTE=""
PR_REMOTE=""
BASE_BRANCH=""
CURSOR_CMD=""
CODEX_CMD=""
WT_ROOT=""
HAS_RG=0

usage() {
  cat <<'EOF'
Usage:
  wt open <branch> [--codex] [--cursor] [--dry-run] [-v]
  wt pr <prNum> [--review] [--codex|--cursor] [--base <ref>] [--dry-run] [-v]
  wt review <prNum> [--codex|--cursor] [--base <ref>] [--dry-run] [-v]
  wt deconflict <prNum> [--codex] [--head-owner <login>] [--head-repo <owner/repo>] [--merge|--rebase] [--dry-run] [-v]
  wt deconflict <prNum> --push [--head-owner <login>] [--head-repo <owner/repo>] [--merge|--rebase] [--no-fallback] [--dry-run] [-v]
  wt sync [--dry-run] [-v]
  wt --version

Config:
  ~/.config/wt/config
  required: REPO_ROOT, DEFAULT_REMOTE, BASE_BRANCH, CURSOR_CMD, CODEX_CMD
  optional: PR_REMOTE (default: origin, used by `wt pr`)
EOF
}

die() {
  echo "[wt][ERROR] $*" >&2
  exit 1
}

die_usage() {
  echo "[wt][ERROR] $*" >&2
  exit 2
}

warn_deconflict() {
  local msg="$1"
  echo "[wt][WARN] ${msg}" >&2
  if [[ -n "${DECONFLICT_WARNINGS}" ]]; then
    DECONFLICT_WARNINGS+=$'\n'
  fi
  DECONFLICT_WARNINGS+="${msg}"
}

info() {
  if [[ "${WANT_REVIEW}" == "1" ]]; then
    echo "[wt] $*" >&2
  else
    echo "[wt] $*"
  fi
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

quote_cmd() {
  local out=""
  local arg
  for arg in "$@"; do
    out+=$(printf '%q ' "$arg")
  done
  out="${out% }"
  printf '%s' "${out}"
}

run_cmd() {
  local rendered
  rendered="$(quote_cmd "$@")"
  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] ${rendered}"
    return 0
  fi
  if [[ "${VERBOSE}" == "1" ]]; then
    echo "+ ${rendered}"
  fi
  if [[ "${WANT_REVIEW}" == "1" ]]; then
    "$@" >/dev/null 2>&1
  else
    "$@"
  fi
}

run_shell_cmd() {
  local script="$1"
  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] bash -lc $(printf '%q' "${script}")"
    return 0
  fi
  if [[ "${VERBOSE}" == "1" ]]; then
    echo "+ bash -lc $(printf '%q' "${script}")"
  fi
  bash -lc "${script}"
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

run_id_utc() {
  date -u +"%Y%m%dT%H%M%SZ"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "${s}"
}

json_quote() {
  printf '"%s"' "$(json_escape "$1")"
}

sha1_text() {
  local input="$1"
  if command -v sha1sum >/dev/null 2>&1; then
    printf '%s' "${input}" | sha1sum | awk '{print $1}'
  else
    printf '%s' "${input}" | shasum -a 1 | awk '{print $1}'
  fi
}

normalize_issue_key() {
  local issue="$1"
  issue="$(printf '%s' "${issue}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  printf '%s' "${issue:0:16}"
}

append_csv_unique() {
  local current="$1"
  local value="$2"
  if [[ ",${current}," == *",${value},"* ]]; then
    printf '%s' "${current}"
  elif [[ -n "${current}" ]]; then
    printf '%s, %s' "${current}" "${value}"
  else
    printf '%s' "${value}"
  fi
}

load_config() {
  [[ -f "${CONFIG_FILE}" ]] || die "config not found: ${CONFIG_FILE} (see ai/ai-change-gates/tools/wt/config.example)"
  # shellcheck disable=SC1090
  source "${CONFIG_FILE}"

  REPO_ROOT="${REPO_ROOT:-}"
  DEFAULT_REMOTE="${DEFAULT_REMOTE:-}"
  PR_REMOTE="${PR_REMOTE:-origin}"
  BASE_BRANCH="${BASE_BRANCH:-}"
  CURSOR_CMD="${CURSOR_CMD:-}"
  CODEX_CMD="${CODEX_CMD:-}"
  WT_ROOT="${WT_ROOT:-}"

  [[ -n "${REPO_ROOT}" ]] || die "REPO_ROOT is required in ${CONFIG_FILE}"
  [[ -n "${DEFAULT_REMOTE}" ]] || die "DEFAULT_REMOTE is required in ${CONFIG_FILE}"
  [[ -n "${BASE_BRANCH}" ]] || die "BASE_BRANCH is required in ${CONFIG_FILE}"
  [[ -n "${CURSOR_CMD}" ]] || die "CURSOR_CMD is required in ${CONFIG_FILE}"
  [[ -n "${CODEX_CMD}" ]] || die "CODEX_CMD is required in ${CONFIG_FILE}"

  [[ -d "${REPO_ROOT}" ]] || die "REPO_ROOT does not exist: ${REPO_ROOT}"
  git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "REPO_ROOT is not a git repo: ${REPO_ROOT}"
  if command -v rg >/dev/null 2>&1; then
    HAS_RG=1
  else
    HAS_RG=0
  fi

  if [[ -z "${WT_ROOT}" ]]; then
    WT_ROOT="$(cd "${REPO_ROOT}/.." && pwd)/$(basename "${REPO_ROOT}")-wt"
  fi
}

exec_tool_cmd() {
  # exec_tool_cmd <template> <worktree>
  local template="$1"
  local worktree="$2"
  local script
  if [[ "${template}" == *"%WORKTREE%"* ]]; then
    script="${template//%WORKTREE%/${worktree}}"
  else
    script="cd $(printf '%q' "${worktree}") && ${template}"
  fi
  run_shell_cmd "${script}"
}

ensure_worktree_dirs() {
  local worktree="$1"
  run_cmd mkdir -p "${worktree}/_run/logs" "${worktree}/_run/tmp" "${worktree}/_run/data" "${worktree}/_run/ai"
}

canonical_wt_path() {
  echo "${REPO_ROOT}/ai/ai-change-gates/tools/wt/wt"
}

normalize_path() {
  local p="$1"
  if [[ -d "${p}" ]]; then
    (cd "${p}" >/dev/null 2>&1 && pwd -P) || echo "${p}"
    return 0
  fi
  local d b
  d="$(dirname "${p}")"
  b="$(basename "${p}")"
  if [[ -d "${d}" ]]; then
    echo "$(cd "${d}" >/dev/null 2>&1 && pwd -P)/${b}"
    return 0
  fi
  echo "${p}"
}

worktree_path_for_branch() {
  local branch="$1"
  local branch_ref="refs/heads/${branch}"
  git -C "${REPO_ROOT}" worktree list --porcelain | awk -v b="${branch_ref}" '
    $1=="worktree" { wt=$2 }
    $1=="branch" && $2==b { print wt }
  '
}

github_repo_from_remote_url() {
  local url="$1"
  local owner=""
  local repo=""
  if [[ "${url}" =~ ^git@github.com:([^/]+)/([^/]+)(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  elif [[ "${url}" =~ ^https://github.com/([^/]+)/([^/]+)(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  elif [[ "${url}" =~ ^ssh://git@github.com/([^/]+)/([^/]+)(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  fi
  repo="${repo%.git}"
  if [[ -n "${owner}" && -n "${repo}" ]]; then
    echo "${owner}/${repo}"
  fi
}

resolve_gh_repo_full() {
  local remote
  local url
  local repo_full
  for remote in "${PR_REMOTE:-}" "${DEFAULT_REMOTE:-}" origin; do
    [[ -n "${remote}" ]] || continue
    if ! url="$(git -C "${REPO_ROOT}" remote get-url "${remote}" 2>/dev/null)"; then
      continue
    fi
    repo_full="$(github_repo_from_remote_url "${url}")"
    if [[ -n "${repo_full}" ]]; then
      echo "${repo_full}"
      return 0
    fi
  done
  return 1
}

sanitize_ref_component() {
  local input="$1"
  input="${input//\//-}"
  input="$(printf '%s' "${input}" | tr -c '[:alnum:]._-' '-')"
  input="${input#-}"
  input="${input%-}"
  [[ -n "${input}" ]] || input="unknown"
  printf '%s' "${input}"
}

deconflict_name_for_pr() {
  local pr_num="$1"
  local base_ref="$2"
  local base_norm
  base_norm="$(sanitize_ref_component "${base_ref}")"
  printf 'deconflict-pr-%s-%s' "${pr_num}" "${base_norm}"
}

fetch_deconflict_pr_meta() {
  local pr_num="$1"
  local repo_full=""
  local gh_cmd=()
  local meta_json_fields="url,number,title,body,baseRefName,headRefName,headRepository,headRepositoryOwner"
  local gh_output=""
  local gh_rc=0

  DECONFLICT_META_STATUS="ok"
  DECONFLICT_PR_NUMBER="${pr_num}"
  DECONFLICT_PR_TITLE="<missing>"
  DECONFLICT_BASE_REF="${BASE_BRANCH}"
  DECONFLICT_HEAD_REF=""
  DECONFLICT_META_HEAD_REPO=""
  DECONFLICT_META_HEAD_OWNER=""
  DECONFLICT_PR_BODY=""
  DECONFLICT_PR_META_RAW='{}'

  repo_full="$(resolve_gh_repo_full || true)"
  if [[ -n "${repo_full}" ]]; then
    DECONFLICT_PR_URL="https://github.com/${repo_full}/pull/${pr_num}"
  else
    DECONFLICT_PR_URL="PR#${pr_num}"
    warn_deconflict "failed to resolve GitHub repo from remotes; using degraded metadata for #${pr_num}"
    DECONFLICT_META_STATUS="degraded"
    return 0
  fi

  if ! command -v gh >/dev/null 2>&1; then
    warn_deconflict "gh is unavailable; using degraded metadata for #${pr_num}"
    DECONFLICT_META_STATUS="degraded"
    return 0
  fi

  gh_cmd=(gh pr view "${pr_num}" --repo "${repo_full}")
  set +e
  gh_output="$("${gh_cmd[@]}" --json "${meta_json_fields}" 2>&1)"
  gh_rc=$?
  set -e
  if [[ "${gh_rc}" != "0" ]]; then
    warn_deconflict "failed to load PR metadata for #${pr_num}: ${gh_output}"
    DECONFLICT_META_STATUS="degraded"
    return 0
  fi

  DECONFLICT_PR_META_RAW="${gh_output}"

  if command -v jq >/dev/null 2>&1; then
    DECONFLICT_PR_URL="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.url // ""')"
    DECONFLICT_PR_NUMBER="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.number // empty')"
    DECONFLICT_PR_TITLE="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.title // ""')"
    DECONFLICT_BASE_REF="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.baseRefName // ""')"
    DECONFLICT_HEAD_REF="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.headRefName // ""')"
    DECONFLICT_META_HEAD_REPO="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.headRepository.nameWithOwner // ""')"
    DECONFLICT_META_HEAD_OWNER="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.headRepositoryOwner.login // ""')"
    DECONFLICT_PR_BODY="$(printf '%s' "${DECONFLICT_PR_META_RAW}" | jq -r '.body // ""')"
  else
    warn_deconflict "jq is unavailable; extracting PR fields via gh --jq fallback"
    DECONFLICT_PR_URL="$("${gh_cmd[@]}" --json url --jq '.url' 2>/dev/null || true)"
    DECONFLICT_PR_NUMBER="$("${gh_cmd[@]}" --json number --jq '.number' 2>/dev/null || true)"
    DECONFLICT_PR_TITLE="$("${gh_cmd[@]}" --json title --jq '.title' 2>/dev/null || true)"
    DECONFLICT_BASE_REF="$("${gh_cmd[@]}" --json baseRefName --jq '.baseRefName' 2>/dev/null || true)"
    DECONFLICT_HEAD_REF="$("${gh_cmd[@]}" --json headRefName --jq '.headRefName' 2>/dev/null || true)"
    DECONFLICT_META_HEAD_REPO="$("${gh_cmd[@]}" --json headRepository --jq '.headRepository.nameWithOwner // ""' 2>/dev/null || true)"
    DECONFLICT_META_HEAD_OWNER="$("${gh_cmd[@]}" --json headRepositoryOwner --jq '.headRepositoryOwner.login // ""' 2>/dev/null || true)"
    DECONFLICT_PR_BODY="$("${gh_cmd[@]}" --json body --jq '.body // ""' 2>/dev/null || true)"
  fi

  [[ -n "${DECONFLICT_PR_URL}" ]] || DECONFLICT_PR_URL="https://github.com/${repo_full}/pull/${pr_num}"
  [[ -n "${DECONFLICT_PR_NUMBER}" ]] || DECONFLICT_PR_NUMBER="${pr_num}"
  [[ -n "${DECONFLICT_PR_TITLE}" ]] || DECONFLICT_PR_TITLE="<missing>"
  if [[ -z "${DECONFLICT_BASE_REF}" ]]; then
    DECONFLICT_BASE_REF="${BASE_BRANCH}"
    warn_deconflict "missing baseRefName in PR metadata; fallback to BASE_BRANCH=${BASE_BRANCH}"
    DECONFLICT_META_STATUS="degraded"
  fi
  if [[ -z "${DECONFLICT_HEAD_REF}" ]]; then
    warn_deconflict "missing headRefName in PR metadata; prepare will create worktree from base branch only"
    DECONFLICT_META_STATUS="degraded"
  fi
}
resolve_deconflict_head_target() {
  local repo_name=""
  local resolved_from="pr-meta"
  if [[ -n "${DECONFLICT_META_HEAD_REPO}" && "${DECONFLICT_META_HEAD_REPO}" == */* ]]; then
    repo_name="${DECONFLICT_META_HEAD_REPO#*/}"
  else
    repo_name="$(basename "${REPO_ROOT}")"
  fi

  if [[ -n "${DECONFLICT_HEAD_REPO}" ]]; then
    if [[ ! "${DECONFLICT_HEAD_REPO}" =~ ^[^/]+/[^/]+$ ]]; then
      die_usage "--head-repo expects <owner/repo>, got: ${DECONFLICT_HEAD_REPO}"
    fi
    DECONFLICT_EFFECTIVE_HEAD_REPO="${DECONFLICT_HEAD_REPO}"
    DECONFLICT_EFFECTIVE_HEAD_OWNER="${DECONFLICT_HEAD_REPO%%/*}"
    resolved_from="flag --head-repo"
    if [[ -n "${DECONFLICT_HEAD_OWNER}" && "${DECONFLICT_HEAD_OWNER}" != "${DECONFLICT_EFFECTIVE_HEAD_OWNER}" ]]; then
      warn_deconflict "--head-owner (${DECONFLICT_HEAD_OWNER}) differs from --head-repo owner (${DECONFLICT_EFFECTIVE_HEAD_OWNER}); using --head-repo owner"
    fi
  elif [[ -n "${DECONFLICT_HEAD_OWNER}" ]]; then
    DECONFLICT_EFFECTIVE_HEAD_OWNER="${DECONFLICT_HEAD_OWNER}"
    DECONFLICT_EFFECTIVE_HEAD_REPO="${DECONFLICT_HEAD_OWNER}/${repo_name}"
    resolved_from="flag --head-owner"
  else
    DECONFLICT_EFFECTIVE_HEAD_OWNER="${DECONFLICT_META_HEAD_OWNER}"
    DECONFLICT_EFFECTIVE_HEAD_REPO="${DECONFLICT_META_HEAD_REPO}"
  fi

  if [[ -z "${DECONFLICT_EFFECTIVE_HEAD_OWNER}" ]]; then
    DECONFLICT_EFFECTIVE_HEAD_OWNER="${DECONFLICT_DEFAULT_HEAD_OWNER}"
  fi
  if [[ -z "${DECONFLICT_EFFECTIVE_HEAD_REPO}" ]]; then
    DECONFLICT_EFFECTIVE_HEAD_REPO="${DECONFLICT_EFFECTIVE_HEAD_OWNER}/${repo_name}"
  fi

  if [[ -n "${DECONFLICT_META_HEAD_OWNER}" && -n "${DECONFLICT_HEAD_OWNER}" && "${DECONFLICT_HEAD_OWNER}" != "${DECONFLICT_META_HEAD_OWNER}" ]]; then
    warn_deconflict "head owner mismatch: PR meta=${DECONFLICT_META_HEAD_OWNER}, flag=${DECONFLICT_HEAD_OWNER}; using flag value"
  fi
  if [[ -n "${DECONFLICT_META_HEAD_REPO}" && -n "${DECONFLICT_HEAD_REPO}" && "${DECONFLICT_HEAD_REPO}" != "${DECONFLICT_META_HEAD_REPO}" ]]; then
    warn_deconflict "head repo mismatch: PR meta=${DECONFLICT_META_HEAD_REPO}, flag=${DECONFLICT_HEAD_REPO}; using flag value"
  fi
  if [[ -z "${DECONFLICT_HEAD_OWNER}" && -n "${DECONFLICT_META_HEAD_OWNER}" && "${DECONFLICT_META_HEAD_OWNER}" != "${DECONFLICT_DEFAULT_HEAD_OWNER}" ]]; then
    warn_deconflict "default expected head owner is ${DECONFLICT_DEFAULT_HEAD_OWNER}, but PR meta owner is ${DECONFLICT_META_HEAD_OWNER}"
  fi

  DECONFLICT_HEAD_REMOTE_URL="git@github.com:${DECONFLICT_EFFECTIVE_HEAD_REPO}.git"
  if [[ "${VERBOSE}" == "1" ]]; then
    echo "[wt] deconflict head target resolved from ${resolved_from}: ${DECONFLICT_EFFECTIVE_HEAD_REPO} (${DECONFLICT_HEAD_REF})"
  fi
}
ensure_deconflict_head_remote() {
  local repo_path="$1"
  if git -C "${repo_path}" remote get-url head >/dev/null 2>&1; then
    run_cmd git -C "${repo_path}" remote set-url head "${DECONFLICT_HEAD_REMOTE_URL}"
  else
    run_cmd git -C "${repo_path}" remote add head "${DECONFLICT_HEAD_REMOTE_URL}"
  fi
}

write_deconflict_pr_artifacts() {
  local worktree="$1"
  local pr_meta_path="${worktree}/_run/ai/pr_meta.json"
  local pr_body_path="${worktree}/_run/ai/pr_body.md"

  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] write ${pr_meta_path}"
    echo "[dry-run] write ${pr_body_path}"
    return 0
  fi

  printf '%s\n' "${DECONFLICT_PR_META_RAW}" > "${pr_meta_path}"
  printf '%s\n' "${DECONFLICT_PR_BODY}" > "${pr_body_path}"
}

extract_deconflict_intent_section() {
  local body_file="$1"
  local intent_file="$2"
  local tmp_file=""
  local rc=0

  : > "${intent_file}"
  [[ -f "${body_file}" ]] || return 1

  tmp_file="$(mktemp "$(dirname "${intent_file}")/intent_extract.XXXXXX")"
  set +e
  awk '
    function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
    function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
    function trim(s) { return rtrim(ltrim(s)) }
    function normalize_heading(s, t) {
      t = tolower(s)
      t = trim(t)
      sub(/^#+[[:space:]]*/, "", t)
      gsub(/^[*_`~]+/, "", t)
      gsub(/[*_`~]+$/, "", t)
      gsub(/[[:space:]]+/, " ", t)
      gsub(/[[:space:]]*[?:：。．.]+[[:space:]]*$/, "", t)
      t = trim(t)
      return t
    }
    function is_target_heading(s, n) {
      n = normalize_heading(s)
      return (n ~ /^what changed( and how does it work)?$/ || (index(n, "what changed") > 0 && index(n, "how does it work") > 0))
    }
    BEGIN {
      in_section = 0
      found_heading = 0
    }
    {
      raw = $0
      if (in_section == 0 && is_target_heading(raw)) {
        in_section = 1
        found_heading = 1
        next
      }
      if (in_section == 1) {
        if (raw ~ /^[[:space:]]*#/) {
          exit
        }
        print raw
      }
    }
    END {
      if (found_heading == 0) {
        exit 2
      }
    }
  ' "${body_file}" > "${tmp_file}"
  rc=$?
  set -e

  if [[ "${rc}" != "0" ]]; then
    rm -f "${tmp_file}"
    : > "${intent_file}"
    return 1
  fi

  awk '
    {
      line = $0
      sub(/[[:space:]]+$/, "", line)
      rows[NR] = line
      if (line ~ /[^[:space:]]/) {
        if (first == 0) {
          first = NR
        }
        last = NR
      }
    }
    END {
      if (first == 0) {
        exit 0
      }
      for (i = first; i <= last; i++) {
        print rows[i]
      }
    }
  ' "${tmp_file}" > "${intent_file}"

  rm -f "${tmp_file}"
  [[ -s "${intent_file}" ]]
}

write_deconflict_policy() {
  local worktree="$1"
  local policy_file="${worktree}/_run/ai/pr_policy.md"
  local intent_file="${worktree}/_run/ai/pr_intent.txt"

  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] write ${policy_file}"
    return 0
  fi

  cat > "${policy_file}" <<EOF_POLICY
# PR Deconflict Policy (Intent-driven)

## Metadata
- PR: ${DECONFLICT_PR_URL}
- Base: ${DECONFLICT_BASE_REF}
- Head: ${DECONFLICT_EFFECTIVE_HEAD_OWNER}:${DECONFLICT_HEAD_REF}

## Rules
- PreferHEAD: true

## Intent (must preserve)
EOF_POLICY

  if [[ -s "${intent_file}" ]]; then
    cat "${intent_file}" >> "${policy_file}"
  else
    echo "(missing)" >> "${policy_file}"
  fi

  cat >> "${policy_file}" <<'EOF_POLICY'

## KEEP (allowlist, optional)
# Use for concrete symbols/keywords that must exist.
KEEP:
  - symbol:

## NOTOUCH (denylist, optional)
NOTOUCH:
  - path:

## ExtraChecks (optional)
ExtraChecks:
  - cmd:

## Notes
- If Intent is missing, manually fill it using PR description.
EOF_POLICY
}

prepare_deconflict_intent_policy() {
  local worktree="$1"
  local body_file="${worktree}/_run/ai/pr_body.md"
  local intent_file="${worktree}/_run/ai/pr_intent.txt"

  DECONFLICT_INTENT_STATUS="missing"

  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] write ${intent_file}"
    return 0
  fi

  if extract_deconflict_intent_section "${body_file}" "${intent_file}"; then
    DECONFLICT_INTENT_STATUS="found"
  else
    : > "${intent_file}"
    DECONFLICT_INTENT_STATUS="missing"
    warn_deconflict "failed to extract section 'What changed and how does it work?' from PR body; Intent requires manual fill"
  fi

  write_deconflict_policy "${worktree}"
}

render_deconflict_warnings_markdown() {
  if [[ -z "${DECONFLICT_WARNINGS}" ]]; then
    echo "- (none)"
    return 0
  fi

  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    echo "- ${line}"
  done <<< "${DECONFLICT_WARNINGS}"
}
scan_deconflict_markers() {
  local worktree="$1"
  local marker_file="${worktree}/_run/ai/conflict_markers.txt"
  local tmp_file
  local scan_rc

  DECONFLICT_MARKER_SCAN_FILE="_run/ai/conflict_markers.txt"
  DECONFLICT_MARKER_LINE_COUNT=0
  DECONFLICT_MARKER_FILE_COUNT=0
  DECONFLICT_MARKER_SCAN_STATUS="clean"

  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] scan conflict markers under ${worktree}"
    DECONFLICT_MARKER_SCAN_STATUS="dry-run"
    return 0
  fi

  tmp_file="$(mktemp "${worktree}/_run/tmp/marker_scan.XXXXXX")"
  set +e
  grep -R -n -E '^(<<<<<<< |>>>>>>> )' --exclude-dir=.git --exclude-dir=_run "${worktree}" > "${tmp_file}"
  scan_rc=$?
  set -e

  if [[ "${scan_rc}" -gt 1 ]]; then
    rm -f "${tmp_file}"
    DECONFLICT_MARKER_SCAN_STATUS="error"
    die "failed to scan conflict markers in ${worktree}"
  fi

  if [[ "${scan_rc}" == "0" ]]; then
    sed "s#^${worktree}/##" "${tmp_file}" > "${marker_file}"
    DECONFLICT_MARKER_LINE_COUNT="$(wc -l < "${marker_file}" | tr -d '[:space:]')"
    DECONFLICT_MARKER_FILE_COUNT="$(cut -d: -f1 "${marker_file}" | sort -u | wc -l | tr -d '[:space:]')"
    DECONFLICT_MARKER_SCAN_STATUS="found"
    warn_deconflict "detected conflict markers in working tree: files=${DECONFLICT_MARKER_FILE_COUNT}, lines=${DECONFLICT_MARKER_LINE_COUNT}"
  else
    : > "${marker_file}"
    DECONFLICT_MARKER_SCAN_STATUS="clean"
  fi

  rm -f "${tmp_file}"
}

