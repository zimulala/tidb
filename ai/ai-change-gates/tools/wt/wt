deconflict_prepare() {
  local pr_num="$1"
  local local_name local_branch worktree occupied occupied_norm worktree_norm
  local remote_old_sha=""
  local base_tracking_ref=""
  local use_base_fallback=0
  local head_fetch_rc=0

  DECONFLICT_WARNINGS=""
  DECONFLICT_INTENT_STATUS="not-run"

  fetch_deconflict_pr_meta "${pr_num}"
  resolve_deconflict_head_target

  local_name="$(deconflict_name_for_pr "${pr_num}" "${DECONFLICT_BASE_REF}")"
  local_branch="${local_name}"
  worktree="${WT_ROOT}/${local_name}"
  worktree_norm="$(normalize_path "${worktree}")"

  info "repo=${REPO_ROOT}"
  info "worktree=${worktree}"
  info "pr=${pr_num}"
  info "base_ref=${DECONFLICT_BASE_REF}"
  info "head_ref=${DECONFLICT_HEAD_REF}"
  info "head_repo=${DECONFLICT_EFFECTIVE_HEAD_REPO}"

  run_cmd mkdir -p "${WT_ROOT}"

  occupied="$(worktree_path_for_branch "${local_branch}" | head -n1 || true)"
  occupied_norm=""
  if [[ -n "${occupied}" ]]; then
    occupied_norm="$(normalize_path "${occupied}")"
  fi
  if [[ -n "${occupied_norm}" && "${occupied_norm}" != "${worktree_norm}" ]]; then
    die "branch ${local_branch} is already attached at ${occupied}; refusing to switch current workspace"
  fi

  if [[ -n "${DECONFLICT_HEAD_REF}" ]]; then
    ensure_deconflict_head_remote "${REPO_ROOT}"

    if [[ "${DRY_RUN}" == "1" ]]; then
      if [[ -n "${occupied_norm}" && "${occupied_norm}" == "${worktree_norm}" && -d "${worktree}" ]]; then
        echo "[dry-run] git -C ${REPO_ROOT} fetch head +${DECONFLICT_HEAD_REF}:refs/remotes/head/${DECONFLICT_HEAD_REF}"
      else
        echo "[dry-run] git -C ${REPO_ROOT} fetch head +${DECONFLICT_HEAD_REF}:refs/heads/${local_branch}"
      fi
    else
      set +e
      if [[ -n "${occupied_norm}" && "${occupied_norm}" == "${worktree_norm}" && -d "${worktree}" ]]; then
        info "branch ${local_branch} is already attached to target worktree; fetch head/${DECONFLICT_HEAD_REF} without updating local branch"
        git -C "${REPO_ROOT}" fetch head "+${DECONFLICT_HEAD_REF}:refs/remotes/head/${DECONFLICT_HEAD_REF}"
        head_fetch_rc=$?
      else
        git -C "${REPO_ROOT}" fetch head "+${DECONFLICT_HEAD_REF}:refs/heads/${local_branch}"
        head_fetch_rc=$?
      fi
      set -e
      if [[ "${head_fetch_rc}" != "0" ]]; then
        warn_deconflict "failed to fetch head/${DECONFLICT_HEAD_REF}; fallback to base branch ${DECONFLICT_BASE_REF}"
        use_base_fallback=1
      fi
    fi
  else
    use_base_fallback=1
  fi

  if [[ "${use_base_fallback}" == "1" ]]; then
    base_tracking_ref="${DEFAULT_REMOTE}/${DECONFLICT_BASE_REF}"
    if [[ "${DRY_RUN}" == "1" ]]; then
      echo "[dry-run] git -C ${REPO_ROOT} fetch ${DEFAULT_REMOTE} ${DECONFLICT_BASE_REF}"
      if [[ -z "${occupied_norm}" ]]; then
        echo "[dry-run] git -C ${REPO_ROOT} branch -f ${local_branch} ${base_tracking_ref}"
      fi
    else
      set +e
      git -C "${REPO_ROOT}" fetch "${DEFAULT_REMOTE}" "${DECONFLICT_BASE_REF}"
      head_fetch_rc=$?
      set -e
      if [[ "${head_fetch_rc}" != "0" ]]; then
        die "failed to fetch ${DEFAULT_REMOTE}/${DECONFLICT_BASE_REF} for fallback worktree"
      fi
      if [[ -z "${occupied_norm}" ]]; then
        run_cmd git -C "${REPO_ROOT}" branch -f "${local_branch}" "${base_tracking_ref}"
      fi
    fi
  fi

  if [[ -d "${worktree}" ]]; then
    info "worktree exists: ${worktree}"
  else
    run_cmd git -C "${REPO_ROOT}" worktree add "${worktree}" "${local_branch}"
  fi

  ensure_worktree_dirs "${worktree}"
  write_deconflict_ai_workspace "${worktree}" "${local_branch}"
  write_deconflict_pr_artifacts "${worktree}"
  prepare_deconflict_intent_policy "${worktree}"
  scan_deconflict_markers "${worktree}"

  if [[ "${DECONFLICT_MARKER_SCAN_STATUS}" == "found" ]]; then
    warn_deconflict "marker scan hit residual conflict markers in file contents; this is not Git merge conflict state"
    info "marker scan found residual conflict markers (not Git merge conflict state)."
    info "next: clean marker files, run gofmt, then run go test ./... -run TestNonExistent"
  fi

  if [[ "${DRY_RUN}" == "1" ]]; then
    remote_old_sha="<dry-run>"
  elif [[ -n "${DECONFLICT_HEAD_REF}" ]]; then
    set +e
    remote_old_sha="$(git -C "${REPO_ROOT}" ls-remote head "refs/heads/${DECONFLICT_HEAD_REF}" | awk 'NR==1{print $1}')"
    set -e
    if [[ -z "${remote_old_sha}" ]]; then
      remote_old_sha="<missing>"
      warn_deconflict "failed to resolve remote SHA for head/${DECONFLICT_HEAD_REF} during prepare"
    fi
  else
    remote_old_sha="<missing-head-ref>"
  fi

  if [[ "${WANT_CODEX}" == "1" ]]; then
    launch_deconflict_codex "${worktree}"
  fi

  write_deconflict_prepare_report "${worktree}" "${local_branch}" "${remote_old_sha}"
}
deconflict_push() {
  local pr_num="$1"
  local local_name local_branch worktree report
  local current_branch current_sha local_branch_sha
  local old_sha new_sha push_target push_output push_rc
  local fallback_branch fallback_target fallback_output fallback_rc

  fetch_deconflict_pr_meta "${pr_num}"
  resolve_deconflict_head_target

  local_name="$(deconflict_name_for_pr "${pr_num}" "${DECONFLICT_BASE_REF}")"
  local_branch="${local_name}"
  worktree="${WT_ROOT}/${local_name}"
  report="${worktree}/_run/ai/deconflict_report.md"

  [[ -d "${worktree}" ]] || die "worktree not found: ${worktree}; run 'wt deconflict ${pr_num}' first"
  ensure_deconflict_head_remote "${worktree}"
  ensure_worktree_dirs "${worktree}"

  if [[ "${DRY_RUN}" != "1" ]]; then
    printf '%s\n' "${DECONFLICT_PR_META_RAW}" > "${worktree}/_run/ai/pr_meta.json"
  else
    echo "[dry-run] write ${worktree}/_run/ai/pr_meta.json"
  fi
  if [[ "${DRY_RUN}" != "1" && ! -f "${report}" ]]; then
    cat > "${report}" <<EOF
# Deconflict Report

## Metadata
- generated_at_utc: $(now_utc)
- pr_url: ${DECONFLICT_PR_URL}
- pr_number: ${DECONFLICT_PR_NUMBER}
- pr_title: ${DECONFLICT_PR_TITLE}
- base_ref: ${DECONFLICT_BASE_REF}
- head_ref: ${DECONFLICT_HEAD_REF}
- effective_head_owner: ${DECONFLICT_EFFECTIVE_HEAD_OWNER}
- effective_head_repo: ${DECONFLICT_EFFECTIVE_HEAD_REPO}
- worktree_path: ${worktree}
- local_branch: ${local_branch}
EOF
  fi

  current_branch="$(git -C "${worktree}" rev-parse --abbrev-ref HEAD)"
  current_sha="$(git -C "${worktree}" rev-parse HEAD)"
  local_branch_sha="$(git -C "${worktree}" rev-parse "${local_branch}" 2>/dev/null || true)"
  if [[ "${current_branch}" != "${local_branch}" && ( -z "${local_branch_sha}" || "${local_branch_sha}" != "${current_sha}" ) ]]; then
    die "worktree HEAD is not on ${local_branch}; current branch=${current_branch}, head=${current_sha}"
  fi

  if [[ "${DRY_RUN}" == "1" ]]; then
    old_sha="<dry-run>"
    push_target="${DECONFLICT_EFFECTIVE_HEAD_OWNER}:${DECONFLICT_HEAD_REF}"
    append_deconflict_push_report "${report}" "DRY_RUN" "${old_sha}" "${current_sha}" "${push_target}" "skipped push"
    return 0
  fi

  run_cmd git -C "${worktree}" fetch head "+${DECONFLICT_HEAD_REF}:refs/remotes/head/${DECONFLICT_HEAD_REF}"
  old_sha="$(git -C "${worktree}" ls-remote head "refs/heads/${DECONFLICT_HEAD_REF}" | awk 'NR==1{print $1}')"
  [[ -n "${old_sha}" ]] || die "failed to resolve remote old SHA for head/${DECONFLICT_HEAD_REF}"

  set +e
  push_output="$(git -C "${worktree}" push --force-with-lease="head/${DECONFLICT_HEAD_REF}:${old_sha}" head "HEAD:${DECONFLICT_HEAD_REF}" 2>&1)"
  push_rc=$?
  set -e

  push_target="${DECONFLICT_EFFECTIVE_HEAD_OWNER}:${DECONFLICT_HEAD_REF}"
  new_sha="${current_sha}"
  if [[ "${push_rc}" == "0" ]]; then
    append_deconflict_push_report "${report}" "SUCCESS" "${old_sha}" "${new_sha}" "${push_target}" "pushed with --force-with-lease"
    info "push success: ${push_target} (${old_sha} -> ${new_sha})"
    return 0
  fi

  append_deconflict_push_report "${report}" "FAILED" "${old_sha}" "${new_sha}" "${push_target}" "${push_output}"
  if [[ "${DECONFLICT_NO_FALLBACK}" == "1" ]]; then
    die "push failed and --no-fallback is set: ${push_output}"
  fi

  git -C "${worktree}" remote get-url zimuxia >/dev/null 2>&1 || die "push failed and fallback remote 'zimuxia' not found: ${push_output}"
  fallback_branch="zimuxia/${local_name}"
  fallback_target="zimuxia:${fallback_branch}"
  set +e
  fallback_output="$(git -C "${worktree}" push -u zimuxia "HEAD:${fallback_branch}" 2>&1)"
  fallback_rc=$?
  set -e
  if [[ "${fallback_rc}" != "0" ]]; then
    append_deconflict_push_report "${report}" "FALLBACK_FAILED" "${old_sha}" "${new_sha}" "${fallback_target}" "${fallback_output}"
    die "push failed on head and fallback failed: ${fallback_output}"
  fi

  append_deconflict_push_report "${report}" "FALLBACK_SUCCESS" "${old_sha}" "${new_sha}" "${fallback_target}" "created fallback branch on fork"
  cat <<EOF
[wt] push to head failed; fallback branch pushed to ${fallback_target}
Alternative PR command:
gh pr create --base ${DECONFLICT_BASE_REF} --head zimuxia:${fallback_branch} --title "[deconflict] ${DECONFLICT_PR_TITLE}" --body "Deconflict fallback for ${DECONFLICT_PR_URL}"

Comment template for original PR:
I don't have permission to push to \`${DECONFLICT_EFFECTIVE_HEAD_OWNER}:${DECONFLICT_HEAD_REF}\`.
I pushed conflict-resolution commits to my fork branch \`zimuxia:${fallback_branch}\` instead.
Please review via replacement PR: <REPLACEMENT_PR_URL>
EOF
}

deconflict_workflow() {
  local pr_num="$1"
  [[ "${pr_num}" =~ ^[0-9]+$ ]] || die "prNum must be a number"
  if [[ "${DECONFLICT_PUSH}" == "1" ]]; then
    deconflict_push "${pr_num}"
  else
    deconflict_prepare "${pr_num}"
  fi
}

try_git_switch() {
  local rendered
  rendered="$(quote_cmd git -C "${REPO_ROOT}" "$@")"
  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] ${rendered}"
    return 0
  fi
  if [[ "${VERBOSE}" == "1" ]]; then
    echo "+ ${rendered}"
  fi
  git -C "${REPO_ROOT}" "$@" >/dev/null 2>&1
}

switch_repo_root_away_from_pr_branch() {
  local branch="$1"
  local fallback_remote="${2:-${DEFAULT_REMOTE}}"
  info "${REPO_ROOT} currently on ${branch}; switching away before creating worktree"

  if git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/heads/${BASE_BRANCH}"; then
    if try_git_switch switch "${BASE_BRANCH}"; then
      info "root switched to ${BASE_BRANCH}"
      return 0
    fi
  fi

  if git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/remotes/${fallback_remote}/${BASE_BRANCH}"; then
    if try_git_switch switch -c "${BASE_BRANCH}" --track "${fallback_remote}/${BASE_BRANCH}"; then
      info "root switched to ${BASE_BRANCH} (tracking ${fallback_remote}/${BASE_BRANCH})"
      return 0
    fi
  fi

  if try_git_switch switch --detach; then
    info "root switched to detached HEAD (fallback)"
    return 0
  fi

  die "failed to switch repo root away from ${branch}; please commit/stash local changes, then rerun wt"
}

warn_if_noncanonical_entry() {
