  local pattern="$1"
  local file="$2"
  if [[ "${HAS_RG}" == "1" ]]; then
    rg -q "${pattern}" "${file}" 2>/dev/null
  else
    grep -Eq "${pattern}" "${file}" 2>/dev/null
  fi
}

text_match_n() {
  # text_match_n <pattern> <file>
  local pattern="$1"
  local file="$2"
  if [[ "${HAS_RG}" == "1" ]]; then
    rg -n "${pattern}" "${file}" 2>/dev/null
  else
    grep -nE "${pattern}" "${file}" 2>/dev/null
  fi
}

text_match_n_no_filename() {
  # text_match_n_no_filename <pattern> <file>
  local pattern="$1"
  local file="$2"
  if [[ "${HAS_RG}" == "1" ]]; then
    rg -n --no-filename "${pattern}" "${file}" 2>/dev/null
  else
    grep -nE "${pattern}" "${file}" 2>/dev/null
  fi
}

print_review_stdout() {
  local state="$1"
  local next_hint="${REVIEW_MIN_TESTS_HINT:-<none>}"
  echo "REVIEW_PACK=${state}"
  echo "NEXT=artifacts_dir=${REVIEW_ART_DIR:-<none>} minimal_tests=${next_hint} reminder=use_pr-review_skill"
  echo "DETAILS=manifest=${REVIEW_MANIFEST_FILE:-<none>} risk_scan=${REVIEW_RISK_SCAN_FILE:-<none>} pr_summary=${REVIEW_PR_SUMMARY_FILE:-<none>} review_strategy=${REVIEW_STRATEGY_FILE:-<none>} llm_review=${REVIEW_LLM_REVIEW_FILE:-<none>} findings=${REVIEW_FINDINGS_FILE:-<none>} result=${REVIEW_RESULT_FILE:-<none>}"
  echo "===ONECLICK_JSON_BEGIN==="
  if [[ -n "${REVIEW_RESULT_FILE}" && -f "${REVIEW_RESULT_FILE}" ]]; then
    cat "${REVIEW_RESULT_FILE}"
  else
    echo "{\"review_pack\":\"${state}\",\"reason\":\"result file missing\"}"
  fi
  echo "===ONECLICK_JSON_END==="
}

generate_review_pack() {
  # generate_review_pack <pr_num> <pr_remote> <worktree> <branch>
  local pr_num="$1"
  local pr_remote="$2"
  local worktree="$3"
  local branch="$4"

  local run_id ts context_dir analysis_dir llm_dir
  local pr_meta_file git_status_file commits_file diffstat_file changed_files_file diff_patch_file
  local review_strategy_file next_file llm_review_file findings_file
  local head_sha base_ref base_candidate base_sha range patch_id env_summary tool_cmd
  local commit_count changed_count top_dirs ext_stats diff_patch_tmp diff_patch_bytes patch_cap_bytes
  local pr_url="" pr_title="" pr_head_ref="" pr_head_sha=""
  local repo_owner="" repo_name="" origin_url="" repo_full="" gh_meta="" gh_rc=1
  local high_hits_file medium_hits_file low_hits_file must_tests_file optional_tests_file
  local high_sorted_file medium_sorted_file low_sorted_file hotspots_tmp_file
  local findings_tmp_file findings_md_tmp_file
  local change_types="" has_only_tests=0
  local p0_fatal_in_goroutine=0 p0_channel_no_timeout=0
  local rel abs line recv_line line_no content go_line d suite
  local first_must_test="<none>" loc issue action verify_min verify_opt cleanup closure
  local finding_type must_fix impact scope probability must_fix_bool issue_key fingerprint
  local loc_file loc_line idx=0

  ts="$(now_utc)"
  run_id="$(run_id_utc)_pr${pr_num}_$(git -C "${worktree}" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  REVIEW_ART_DIR="${REPO_ROOT}/ai/artifacts/wt_review/pr-${pr_num}/${run_id}"
  REVIEW_TRACE_FILE="${REVIEW_ART_DIR}/trace.jsonl"
  REVIEW_MANIFEST_FILE="${REVIEW_ART_DIR}/manifest.json"
  REVIEW_RESULT_FILE="${REVIEW_ART_DIR}/result.json"

  context_dir="${REVIEW_ART_DIR}/context"
  analysis_dir="${REVIEW_ART_DIR}/analysis"
  llm_dir="${REVIEW_ART_DIR}/llm"
  REVIEW_PR_SUMMARY_FILE="${analysis_dir}/pr_summary.md"
  REVIEW_STRATEGY_FILE="${analysis_dir}/review_strategy.md"
  REVIEW_RISK_SCAN_FILE="${analysis_dir}/risk_scan.md"
  REVIEW_TEST_PLAN_FILE="${analysis_dir}/test_plan.md"
  REVIEW_NEXT_FILE="${analysis_dir}/NEXT.txt"
  REVIEW_LLM_REVIEW_FILE="${llm_dir}/review.md"
  REVIEW_FINDINGS_FILE="${llm_dir}/findings.yaml"

  pr_meta_file="${context_dir}/pr_meta.json"
  git_status_file="${context_dir}/git_status.txt"
  commits_file="${context_dir}/commits.txt"
  diffstat_file="${context_dir}/diffstat.txt"
  changed_files_file="${context_dir}/changed_files.txt"
  diff_patch_file="${context_dir}/diff.patch"
  review_strategy_file="${REVIEW_STRATEGY_FILE}"
  next_file="${REVIEW_NEXT_FILE}"
  llm_review_file="${REVIEW_LLM_REVIEW_FILE}"
  findings_file="${REVIEW_FINDINGS_FILE}"
  diff_patch_tmp="${context_dir}/diff.patch.tmp"
  high_hits_file="${analysis_dir}/.risk_high.tmp"
  medium_hits_file="${analysis_dir}/.risk_medium.tmp"
  low_hits_file="${analysis_dir}/.risk_low.tmp"
  high_sorted_file="${analysis_dir}/.risk_high.sorted.tmp"
  medium_sorted_file="${analysis_dir}/.risk_medium.sorted.tmp"
  low_sorted_file="${analysis_dir}/.risk_low.sorted.tmp"
  hotspots_tmp_file="${analysis_dir}/.hotspots.tmp"
  must_tests_file="${analysis_dir}/.must_tests.tmp"
  optional_tests_file="${analysis_dir}/.optional_tests.tmp"
  findings_tmp_file="${llm_dir}/.findings.tmp"
  findings_md_tmp_file="${llm_dir}/.findings_md.tmp"

  mkdir -p "${context_dir}" "${analysis_dir}" "${llm_dir}" || return 1
  : > "${REVIEW_TRACE_FILE}"
  : > "${high_hits_file}"
  : > "${medium_hits_file}"
  : > "${low_hits_file}"
  : > "${high_sorted_file}"
  : > "${medium_sorted_file}"
  : > "${low_sorted_file}"
  : > "${hotspots_tmp_file}"
  : > "${must_tests_file}"
  : > "${optional_tests_file}"
  : > "${findings_tmp_file}"
  : > "${findings_md_tmp_file}"
  review_trace "init" "ok" "review pack init" "{\"pr\":${pr_num},\"worktree\":$(json_quote "${worktree}")}"

  head_sha="$(git -C "${worktree}" rev-parse HEAD)"
  base_ref="${BASE_OVERRIDE:-${BASE_BRANCH}}"
  base_candidate=""

  for candidate in "${base_ref}" "${pr_remote}/${base_ref}" "${DEFAULT_REMOTE}/${base_ref}" "${DEFAULT_REMOTE}/${BASE_BRANCH}" "${BASE_BRANCH}"; do
    if git -C "${worktree}" rev-parse --verify --quiet "${candidate}^{commit}" >/dev/null; then
      base_candidate="${candidate}"
      break
    fi
  done

  if [[ -n "${base_candidate}" ]]; then
    base_sha="$(git -C "${worktree}" merge-base "${head_sha}" "${base_candidate}" 2>/dev/null || true)"
    if [[ -z "${base_sha}" ]]; then
      base_sha="$(git -C "${worktree}" rev-parse "${base_candidate}^{commit}" 2>/dev/null || true)"
    fi
  else
    base_sha="$(git -C "${worktree}" rev-parse "${head_sha}^" 2>/dev/null || true)"
  fi
  [[ -n "${base_sha}" ]] || base_sha="${head_sha}"
  range="${base_sha}..${head_sha}"
  review_trace "base" "ok" "resolved base/head" "{\"base_ref\":$(json_quote "${base_ref}"),\"base_sha\":$(json_quote "${base_sha}"),\"head_sha\":$(json_quote "${head_sha}")}"

  # Best-effort PR metadata; failures should not break review pack generation.
  origin_url="$(git -C "${REPO_ROOT}" remote get-url "${pr_remote}" 2>/dev/null || true)"
  if [[ "${origin_url}" =~ ^git@github.com:(.+)/(.+)\.git$ ]]; then
    repo_owner="${BASH_REMATCH[1]}"
    repo_name="${BASH_REMATCH[2]}"
  elif [[ "${origin_url}" =~ ^https://github.com/(.+)/(.+)\.git$ ]]; then
    repo_owner="${BASH_REMATCH[1]}"
    repo_name="${BASH_REMATCH[2]}"
  elif [[ "${origin_url}" =~ ^ssh://git@github.com/(.+)/(.+)\.git$ ]]; then
    repo_owner="${BASH_REMATCH[1]}"
    repo_name="${BASH_REMATCH[2]}"
  fi
  if [[ -n "${repo_owner}" && -n "${repo_name}" ]] && command -v gh >/dev/null 2>&1; then
    repo_full="${repo_owner}/${repo_name}"
    set +e
    gh_meta="$(gh pr view "${pr_num}" --repo "${repo_full}" --json url,title,headRefName,headRefOid 2>/dev/null)"
    gh_rc=$?
    set -e
    if [[ "${gh_rc}" == "0" && -n "${gh_meta}" ]]; then
      pr_url="$(echo "${gh_meta}" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p' | head -n1)"
      pr_title="$(echo "${gh_meta}" | sed -n 's/.*"title":"\([^"]*\)".*/\1/p' | head -n1)"
      pr_head_ref="$(echo "${gh_meta}" | sed -n 's/.*"headRefName":"\([^"]*\)".*/\1/p' | head -n1)"
      pr_head_sha="$(echo "${gh_meta}" | sed -n 's/.*"headRefOid":"\([^"]*\)".*/\1/p' | head -n1)"
    fi
  fi
  [[ -n "${pr_head_sha}" ]] || pr_head_sha="${head_sha}"
  [[ -n "${pr_head_ref}" ]] || pr_head_ref="${branch}"

  cat > "${pr_meta_file}" <<EOF
{
  "schema_version": "v1",
  "pr_num": ${pr_num},
  "pr_remote": $(json_quote "${pr_remote}"),
  "repo_root": $(json_quote "${REPO_ROOT}"),
  "worktree_path": $(json_quote "${worktree}"),
  "branch": $(json_quote "${branch}"),
  "base_ref": $(json_quote "${base_ref}"),
  "base_sha": $(json_quote "${base_sha}"),
  "head_ref": $(json_quote "${pr_head_ref}"),
  "head_sha": $(json_quote "${pr_head_sha}"),
  "pr_url": $(json_quote "${pr_url}"),
  "pr_title": $(json_quote "${pr_title}")
}
EOF

  git -C "${worktree}" status --short --branch > "${git_status_file}" || true
  git -C "${worktree}" log --oneline "${range}" > "${commits_file}" || true
  git -C "${worktree}" diff --stat "${range}" > "${diffstat_file}" || true
  git -C "${worktree}" diff --name-only "${range}" > "${changed_files_file}" || true
  git -C "${worktree}" diff "${range}" > "${diff_patch_tmp}" || true

  patch_cap_bytes=$((2 * 1024 * 1024))
  diff_patch_bytes="$(wc -c < "${diff_patch_tmp}" | tr -d ' ')"
  if [[ "${diff_patch_bytes}" -le "${patch_cap_bytes}" ]]; then
    mv "${diff_patch_tmp}" "${diff_patch_file}"
  else
    {
      echo "# diff.patch omitted"
      echo "size_bytes=${diff_patch_bytes}"
      echo "cap_bytes=${patch_cap_bytes}"
      echo "reason=diff_too_large"
    } > "${diff_patch_file}"
    rm -f "${diff_patch_tmp}"
  fi
  review_trace "context" "ok" "context artifacts generated" "{\"changed_files\":$(json_quote "${changed_files_file}")}"

  commit_count="$(grep -cve '^[[:space:]]*$' "${commits_file}" || true)"
  changed_count="$(grep -cve '^[[:space:]]*$' "${changed_files_file}" || true)"
  top_dirs="$(awk -F/ 'NF>=2{print $1"/"$2; next} NF==1{print $1}' "${changed_files_file}" | sort | uniq -c | sort -nr | sed -e 's/^ *//')"
  ext_stats="$(awk -F. 'NF>=2{print $NF}' "${changed_files_file}" | tr '[:upper:]' '[:lower:]' | sort | uniq -c | sort -nr | sed -e 's/^ *//')"

  while IFS= read -r rel; do
    [[ -n "${rel}" ]] || continue
    [[ "${rel}" =~ _test\.go$ ]] || continue
    abs="${worktree}/${rel}"
    [[ -f "${abs}" ]] || continue

    if text_match_q 'go[[:space:]]+func' "${abs}"; then
      while IFS= read -r line; do
        [[ -n "${line}" ]] || continue
        echo "- HIGH: possible fail/assert in goroutine: ${line}" >> "${high_hits_file}"
      done < <(text_match_n_no_filename 't\.FailNow\(|t\.Fatalf?\(|require\.[A-Za-z_]+\(|assert\.[A-Za-z_]+\(|MustExec\(' "${abs}" | awk -F: -v r="${rel}" '{print r ":" $1}')
    fi

    while IFS= read -r recv_line; do
      [[ -n "${recv_line}" ]] || continue
      line_no="$(echo "${recv_line}" | cut -d: -f1)"
      content="$(echo "${recv_line}" | cut -d: -f2-)"
      if echo "${content}" | grep -Eq 'select|time\.After|ctx\.Done|context\.Done|<-chan' 2>/dev/null; then
        continue
      fi
      echo "- MEDIUM: channel receive without timeout/select: ${rel}:${line_no}" >> "${medium_hits_file}"
    done < <(text_match_n '<-[[:space:]]*[A-Za-z_][A-Za-z0-9_\.]*' "${abs}")

    if text_match_q 'go[[:space:]]+(func|\w+)' "${abs}"; then
      if ! text_match_q 'WaitGroup|errgroup|context\.WithCancel|cancel\(|t\.Cleanup\(' "${abs}"; then
        go_line="$(text_match_n 'go[[:space:]]+(func|\w+)' "${abs}" | head -n1 | cut -d: -f1)"
        echo "- MEDIUM: goroutine start without explicit cancel/join pattern: ${rel}:${go_line}" >> "${medium_hits_file}"
      fi
    fi
  done < "${changed_files_file}"

  sort -u "${high_hits_file}" > "${high_sorted_file}" || true
  sort -u "${medium_hits_file}" > "${medium_sorted_file}" || true
  sort -u "${low_hits_file}" > "${low_sorted_file}" || true
  if [[ -s "${high_sorted_file}" ]]; then
    p0_fatal_in_goroutine=1
  fi
  if grep -q 'channel receive without timeout/select' "${medium_sorted_file}" 2>/dev/null; then
    p0_channel_no_timeout=1
  fi

  {
    echo "# Risk Scan"
    echo
    echo "- source: heuristic grep scan over changed *_test.go files"
    echo "- scope: ${changed_count} changed files"
    echo
    echo "## HIGH"
    if [[ -s "${high_sorted_file}" ]]; then
      cat "${high_sorted_file}"
    else
      echo "- none"
    fi
    echo
    echo "## MEDIUM"
    if [[ -s "${medium_sorted_file}" ]]; then
      cat "${medium_sorted_file}"
    else
      echo "- none"
    fi
    echo
    echo "## LOW"
    if [[ -s "${low_sorted_file}" ]]; then
      cat "${low_sorted_file}"
    else
      echo "- none"
    fi
  } > "${REVIEW_RISK_SCAN_FILE}"

  while IFS= read -r rel; do
    [[ -n "${rel}" ]] || continue
    case "${rel}" in
      pkg/*)
        d="$(dirname "${rel}")"
        echo "go test --tags=intest -run TestNonExistent ./${d}/..." >> "${must_tests_file}"
        ;;
      tests/realtikvtest/*)
        echo "go test --tags=intest -run TestNonExistent ./tests/realtikvtest/..." >> "${must_tests_file}"
        ;;
      tests/integrationtest/t/*.test)
        suite="${rel#tests/integrationtest/t/}"
        suite="${suite%.test}"
        echo "pushd tests/integrationtest && ./run-tests.sh -r ${suite} && popd" >> "${optional_tests_file}"
        ;;
    esac
  done < "${changed_files_file}"
  sort -u "${must_tests_file}" -o "${must_tests_file}" || true
  sort -u "${optional_tests_file}" -o "${optional_tests_file}" || true

  REVIEW_MIN_TESTS_HINT="$(head -n 3 "${must_tests_file}" | paste -sd';' - | sed 's/;/; /g')"
  [[ -n "${REVIEW_MIN_TESTS_HINT}" ]] || REVIEW_MIN_TESTS_HINT="<none>"
  first_must_test="$(head -n 1 "${must_tests_file}" || true)"
  [[ -n "${first_must_test}" ]] || first_must_test="go test --tags=intest -run TestNonExistent ./..."

  {
    echo "# Test Plan"
    echo
    echo "## Must"
    if [[ -s "${must_tests_file}" ]]; then
      sed 's/^/- /' "${must_tests_file}"
    else
      echo "- none derived from changed files"
    fi
    echo
    echo "## Recommended Optional"
    if [[ -s "${optional_tests_file}" ]]; then
      sed 's/^/- /' "${optional_tests_file}"
    else
      echo "- none"
    fi
  } > "${REVIEW_TEST_PLAN_FILE}"

  if [[ "${changed_count}" -gt 0 ]]; then
    change_types="$(append_csv_unique "${change_types}" "Correctness")"
  fi
  if grep -Eiq '(^|/)(config|variable|sessionctx|parser|ddl|upgrade|compat)' "${changed_files_file}" 2>/dev/null; then
    change_types="$(append_csv_unique "${change_types}" "Compatibility")"
  fi
  if grep -Eiq '(^|/)(planner|executor|statistics|distsql|cost|benchmark|perf)' "${changed_files_file}" 2>/dev/null; then
    change_types="$(append_csv_unique "${change_types}" "Performance")"
  fi
  if grep -Eiq '(^|/)(metrics|grafana|telemetry|log|zap|trace|tracing|observ)' "${changed_files_file}" 2>/dev/null; then
    change_types="$(append_csv_unique "${change_types}" "Observability")"
  fi
  if grep -Eiq 'refactor|cleanup|reorg|rename' "${commits_file}" 2>/dev/null; then
    change_types="$(append_csv_unique "${change_types}" "Refactor")"
  fi
  if [[ "${changed_count}" -gt 0 ]] && awk 'NF{if($0 !~ /(^tests\/|_test\.go$)/){exit 1}} END{exit 0}' "${changed_files_file}"; then
    has_only_tests=1
  fi
  if [[ "${has_only_tests}" == "1" ]]; then
    change_types="$(append_csv_unique "${change_types}" "TestOnly")"
  fi
  [[ -n "${change_types}" ]] || change_types="Correctness"

  {
    sed -n -E 's/^- [A-Z]+: [^:]+: ([^:]+:[0-9]+)$/\1/p' "${high_sorted_file}" || true
    sed -n -E 's/^- [A-Z]+: [^:]+: ([^:]+:[0-9]+)$/\1/p' "${medium_sorted_file}" || true
    awk 'NF{print $1":1"}' "${changed_files_file}" || true
  } | awk 'NF && !seen[$0]++' | head -n 3 > "${hotspots_tmp_file}"

  {
    echo "# PR Summary"
    echo
    echo "## PR Scope (commit range base..head, artifacts_dir)"
    echo "- commit_range: ${range}"
    echo "- base_sha: ${base_sha}"
    echo "- head_sha: ${head_sha}"
    echo "- artifacts_dir: ${REVIEW_ART_DIR}"
    echo "- worktree: ${worktree}"
    echo
    echo "## ChangeType (multi-select): Correctness | Compatibility | Performance | Observability | Refactor | TestOnly"
    echo "- selected: ${change_types}"
    echo
    echo "## What changed (bullet list from commits/diffstat/changed_files)"
    echo "- commits (${commit_count}):"
    if [[ -s "${commits_file}" ]]; then
      sed -n '1,8p' "${commits_file}" | sed 's/^/  - /'
    else
      echo "  - none"
    fi
    echo "- diffstat:"
    if [[ -s "${diffstat_file}" ]]; then
      sed -n '1,8p' "${diffstat_file}" | sed 's/^/  - /'
    else
      echo "  - none"
    fi
    echo "- changed_files (${changed_count}):"
    if [[ -s "${changed_files_file}" ]]; then
      sed -n '1,12p' "${changed_files_file}" | sed 's/^/  - /'
    else
      echo "  - none"
    fi
    echo
    echo "## Hotspots (top 3 risky files/functions to inspect)"
    if [[ -s "${hotspots_tmp_file}" ]]; then
      sed 's/^/- /' "${hotspots_tmp_file}"
    else
      echo "- none"
    fi
    echo
    echo "## Assumptions / Unknowns (explicit list; avoid guessing)"
    echo "- Risk scan is heuristic from static grep and may miss semantic issues."
    echo "- No heavy/full test suite was executed during pack generation."
    echo "- PR metadata from gh is best-effort; missing fields fall back to local git state."
  } > "${REVIEW_PR_SUMMARY_FILE}"

  {
    echo "# Review Strategy"
    echo
    echo "## Review Priorities (P0/P1/P2 ordered)"
    if [[ "${p0_fatal_in_goroutine}" == "1" ]]; then
      echo "- P0: Investigate Fatal/FailNow/assert-related goroutine findings from ${REVIEW_RISK_SCAN_FILE}."
    fi
    if [[ "${p0_channel_no_timeout}" == "1" ]]; then
      echo "- P0: Validate blocking safety for channel receives without timeout/select in ${REVIEW_RISK_SCAN_FILE}."
    fi
    if [[ "${p0_fatal_in_goroutine}" == "0" && "${p0_channel_no_timeout}" == "0" ]]; then
      echo "- P0: none from heuristic scan; verify critical behavior paths manually."
    fi
    echo "- P1: Review hotspots first, then all changed files for behavior/regression risk."
    echo "- P2: Evaluate refactor/readability/performance opportunities after correctness is clear."
    echo
    echo "## Review Path (what to inspect first, with file pointers)"
    echo "- Step 1: inspect top hotspots listed in ${REVIEW_PR_SUMMARY_FILE}."
    echo "- Step 2: inspect commit intent in ${commits_file} and file impact in ${diffstat_file}."
    echo "- Step 3: inspect all touched files listed in ${changed_files_file}."
    echo "- Input evidence: ${REVIEW_RISK_SCAN_FILE} (non-LLM heuristic scan)."
    echo
    echo "## Merge Gate / Closure Criteria (<=3 bullets, mechanical pass/fail)"
    echo "- No open Must-fix correctness/concurrency findings remain."
    echo "- Minimal verification commands complete without FAIL/panic."
    echo "- Any changed test helpers avoid unsafe goroutine/channel patterns."
    echo
    echo "## Minimal Verification Plan (commands + expected signals)"
    if [[ -s "${must_tests_file}" ]]; then
      while IFS= read -r line; do
        [[ -n "${line}" ]] || continue
        echo "- cmd: ${line}"
        echo "  expected: exits 0, no panic/FAIL output."
      done < <(sed -n '1,5p' "${must_tests_file}")
    else
      echo "- cmd: go test --tags=intest -run TestNonExistent ./..."
      echo "  expected: command is accepted and package path resolves."
    fi
    echo
    echo "## Optional Verification Plan (nice-to-have)"
    if [[ -s "${optional_tests_file}" ]]; then
      sed 's/^/- /' "${optional_tests_file}"
    else
      echo "- none"
    fi
  } > "${review_strategy_file}"

  {
    echo "ARTIFACTS_DIR=${REVIEW_ART_DIR}"
    echo "CODEX_NEXT=run pr-review skill with ARTIFACTS_DIR=${REVIEW_ART_DIR}"
    echo "CODEX_NEXT_CMD=pr-review --artifacts-dir \"${REVIEW_ART_DIR}\""
    echo "MINIMAL_TESTS=${REVIEW_MIN_TESTS_HINT}"
  } > "${next_file}"

  if [[ -s "${high_sorted_file}" ]]; then
    loc="$(sed -n -E 's/^- [A-Z]+: [^:]+: ([^:]+:[0-9]+)$/\1/p' "${high_sorted_file}" | head -n1)"
    [[ -n "${loc}" ]] || loc="unknown:0"
    issue="Fatal/FailNow/assert-like call detected in goroutine context may hide flaky failure semantics."
    action="Confirm assertion/fatal usage is synchronized with the parent test goroutine or refactor to safe error signaling."
    verify_min="${first_must_test}"
    verify_opt="Run affected package tests repeatedly to check flakes."
    cleanup="none"
    closure="Close when goroutine error handling is deterministic and test failure ownership is explicit."
    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
      "Risk" "Yes" "Crash" "local" "Med" "${loc}" "${issue}" "${action}" "${verify_min}" "${verify_opt}" "${cleanup}" "${closure}" >> "${findings_tmp_file}"
  fi

  if grep -q 'channel receive without timeout/select' "${medium_sorted_file}" 2>/dev/null; then
    loc="$(grep -m1 'channel receive without timeout/select' "${medium_sorted_file}" | sed -E 's/^- [A-Z]+: [^:]+: ([^:]+:[0-9]+)$/\1/')"
    [[ -n "${loc}" ]] || loc="unknown:0"
    issue="Channel receive path lacks timeout/select guard and may deadlock on stalled producer."
    action="Wrap receive with select + timeout/context cancellation, or document bounded producer guarantee."
    verify_min="${first_must_test}"
    verify_opt="Add a timeout-focused test that fails before fix and passes after fix."
    cleanup="none"
    closure="Close when channel receive has explicit timeout or cancellation behavior."
    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
      "Bug" "Yes" "Compatibility" "local" "Med" "${loc}" "${issue}" "${action}" "${verify_min}" "${verify_opt}" "${cleanup}" "${closure}" >> "${findings_tmp_file}"
  fi

  if grep -q 'goroutine start without explicit cancel/join pattern' "${medium_sorted_file}" 2>/dev/null; then
    loc="$(grep -m1 'goroutine start without explicit cancel/join pattern' "${medium_sorted_file}" | sed -E 's/^- [A-Z]+: [^:]+: ([^:]+:[0-9]+)$/\1/')"
    [[ -n "${loc}" ]] || loc="unknown:0"
    issue="Started goroutine has no explicit cancel/join lifecycle signal and can leak under failures."
    action="Add WaitGroup/errgroup or explicit cancel + t.Cleanup for goroutine lifecycle control."
    verify_min="${first_must_test}"
    verify_opt="Run with race detector where feasible."
    cleanup="none"
    closure="Close when goroutine lifecycle has deterministic join or cancellation path."
    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
      "Risk" "No" "Observability" "local" "Low" "${loc}" "${issue}" "${action}" "${verify_min}" "${verify_opt}" "${cleanup}" "${closure}" >> "${findings_tmp_file}"
  fi

  if [[ ! -s "${findings_tmp_file}" ]]; then
    cat > "${findings_file}" <<EOF
schema_version: v1
artifacts_dir: "$(json_escape "${REVIEW_ART_DIR}")"
commit_range: "$(json_escape "${range}")"
findings: []
EOF
    echo "- None." > "${findings_md_tmp_file}"
  else
    {
      echo "schema_version: v1"
      echo "artifacts_dir: \"$(json_escape "${REVIEW_ART_DIR}")\""
      echo "commit_range: \"$(json_escape "${range}")\""
      echo "findings:"
      while IFS='|' read -r finding_type must_fix impact scope probability loc issue action verify_min verify_opt cleanup closure; do
        [[ -n "${finding_type}" ]] || continue
        idx=$((idx + 1))
        loc_file="${loc%:*}"
        loc_line="${loc##*:}"
        if [[ "${loc_line}" == "${loc}" || ! "${loc_line}" =~ ^[0-9]+$ ]]; then
          loc_file="${loc}"
          loc_line="0"
        fi
        issue_key="$(normalize_issue_key "${issue}")"
        fingerprint="$(sha1_text "${finding_type}${must_fix}${loc_file}${loc_line}${issue_key}")"
        must_fix_bool="false"
        if [[ "${must_fix}" == "Yes" ]]; then
          must_fix_bool="true"
        fi

        echo "  - id: R${idx}"
        echo "    fingerprint: \"${fingerprint}\""
        echo "    status: open"
        echo "    type: \"$(json_escape "${finding_type}")\""
        echo "    must_fix: ${must_fix_bool}"
        echo "    impact: \"$(json_escape "${impact}")\""
        echo "    scope: \"$(json_escape "${scope}")\""
        echo "    probability: \"$(json_escape "${probability}")\""
        echo "    locations:"
        echo "      - file: \"$(json_escape "${loc_file}")\""
        echo "        line: ${loc_line}"
        echo "    issue: \"$(json_escape "${issue}")\""
        echo "    action: \"$(json_escape "${action}")\""
        echo "    verify_min: \"$(json_escape "${verify_min}")\""
        echo "    verify_opt: \"$(json_escape "${verify_opt}")\""
        echo "    cleanup: \"$(json_escape "${cleanup}")\""
        echo "    closure: \"$(json_escape "${closure}")\""

        {
          echo "${idx}. Type: ${finding_type}"
          echo "   - Must fix: ${must_fix}"
          echo "   - Impact: ${impact}"
          echo "   - Scope: ${scope}"
          echo "   - Probability: ${probability}"
          echo "   - Location(s): ${loc}"
          echo "   - Issue: ${issue}"
          echo "   - Action: ${action}"
          echo "   - Verify(min): ${verify_min}"
          echo "   - Verify(opt): ${verify_opt}"
          echo "   - Cleanup: ${cleanup}"
          echo "   - fingerprint: ${fingerprint}"
          echo "   - closure: ${closure}"
        } >> "${findings_md_tmp_file}"
      done < "${findings_tmp_file}"
    } > "${findings_file}"
  fi

  {
    echo "# LLM Review"
    echo
    echo "## 1) Layer 1 - PR Summary"
    echo "### PR Scope (commit range base..head, artifacts_dir)"
    echo "- commit_range: ${range}"
    echo "- artifacts_dir: ${REVIEW_ART_DIR}"
    echo "- source: ${REVIEW_PR_SUMMARY_FILE}"
    echo
    echo "### ChangeType (multi-select): Correctness | Compatibility | Performance | Observability | Refactor | TestOnly"
    echo "- selected: ${change_types}"
    echo
    echo "### What changed (bullet list from commits/diffstat/changed_files)"
    echo "- See ${REVIEW_PR_SUMMARY_FILE}."
    echo
    echo "### Hotspots (top 3 risky files/functions to inspect)"
    if [[ -s "${hotspots_tmp_file}" ]]; then
      sed 's/^/- /' "${hotspots_tmp_file}"
    else
      echo "- none"
    fi
    echo
    echo "### Assumptions / Unknowns (explicit list; avoid guessing)"
    echo "- Generated from static artifacts without semantic execution."
    echo "- Heavy verification was not executed during pack generation."
    echo
    echo "## 2) Layer 2 - Review Strategy"
    echo "### Review Priorities (P0/P1/P2 ordered)"
    if [[ "${p0_fatal_in_goroutine}" == "1" ]]; then
      echo "- P0: Fatal/FailNow/assert patterns in goroutine context require manual confirmation."
    fi
    if [[ "${p0_channel_no_timeout}" == "1" ]]; then
      echo "- P0: Channel receive timeout/cancel behavior requires manual confirmation."
    fi
    if [[ "${p0_fatal_in_goroutine}" == "0" && "${p0_channel_no_timeout}" == "0" ]]; then
      echo "- P0: none from heuristic scan."
    fi
    echo "- P1: file-level correctness for changed Go code."
    echo "- P2: optimization/readability opportunities."
    echo
    echo "### Review Path (what to inspect first, with file pointers)"
    echo "- Follow ${review_strategy_file} and ${REVIEW_RISK_SCAN_FILE}."
    echo
    echo "### Merge Gate / Closure Criteria (<=3 bullets, mechanical pass/fail)"
    echo "- No open Must-fix findings."
    echo "- Minimal verification passes."
    echo "- Risk-scan P0 patterns explained or fixed."
    echo
    echo "### Minimal Verification Plan (commands + expected signals)"
    echo "- ${first_must_test}"
    echo
    echo "### Optional Verification Plan (nice-to-have)"
    echo "- See ${REVIEW_TEST_PLAN_FILE}."
    echo
    echo "## 3) Layer 3 - Detailed Review"
    echo "### Short Overall Conclusion (merge-ready? yes/no + why)"
    echo "- merge_ready: no"
    echo "- why: this is an auto-generated baseline; manual reviewer confirmation is still required."
    echo
    echo "### Findings list (ranked)"
    cat "${findings_md_tmp_file}"
    echo
    echo "### Executed Minimal Verification (if any; otherwise \"None\")"
    echo "None"
    echo
    echo "### Review Scope Statement (first review? artifacts_dir? commit range? inference vs reproduced?)"
    echo "- review_round: first review baseline generated by wt"
    echo "- artifacts_dir: ${REVIEW_ART_DIR}"
    echo "- commit_range: ${range}"
    echo "- evidence: inference from static artifacts, not reproduced by runtime tests."
  } > "${llm_review_file}"

  review_trace "analysis" "ok" "analysis artifacts generated" "{\"risk_scan\":$(json_quote "${REVIEW_RISK_SCAN_FILE}")}"

  patch_id="$( (git -C "${worktree}" show HEAD | git patch-id --stable | awk '{print $1}') 2>/dev/null || true )"
  [[ -n "${patch_id}" ]] || patch_id="UNKNOWN"
  env_summary="$(uname -s)/$(uname -m)"
  tool_cmd="${WT_INVOCATION}"
  [[ -n "${tool_cmd}" ]] || tool_cmd="$0"

  cat > "${REVIEW_MANIFEST_FILE}" <<EOF
{
  "schema_version": "v1",
  "tool": "wt",
  "tool_version": $(json_quote "${VERSION}"),
  "timestamp": $(json_quote "${ts}"),
  "repo_root": $(json_quote "${REPO_ROOT}"),
  "worktree_path": $(json_quote "${worktree}"),
  "pr_num": ${pr_num},
  "pr_remote": $(json_quote "${pr_remote}"),
  "flags": {
    "review": ${WANT_REVIEW},
    "codex": ${WANT_CODEX},
    "cursor": ${WANT_CURSOR},
    "base_override": $(json_quote "${BASE_OVERRIDE}")
  },
  "git": {
    "commit_sha": $(json_quote "${head_sha}"),
    "base_ref": $(json_quote "${base_ref}"),
    "base_sha": $(json_quote "${base_sha}"),
    "patch_id": $(json_quote "${patch_id}")
  },
  "env": $(json_quote "${env_summary}"),
  "command": $(json_quote "${tool_cmd}"),
  "commands": [
    "git status --short --branch",
    "git log --oneline <base..head>",
    "git diff --stat <base..head>",
    "git diff --name-only <base..head>",
    "git diff <base..head>"
  ],
  "artifacts": {
    "trace": $(json_quote "${REVIEW_TRACE_FILE}"),
    "pr_meta": $(json_quote "${pr_meta_file}"),
    "git_status": $(json_quote "${git_status_file}"),
    "commits": $(json_quote "${commits_file}"),
    "diffstat": $(json_quote "${diffstat_file}"),
    "changed_files": $(json_quote "${changed_files_file}"),
    "diff_patch": $(json_quote "${diff_patch_file}"),
    "pr_summary": $(json_quote "${REVIEW_PR_SUMMARY_FILE}"),
    "review_strategy": $(json_quote "${review_strategy_file}"),
    "risk_scan": $(json_quote "${REVIEW_RISK_SCAN_FILE}"),
    "test_plan": $(json_quote "${REVIEW_TEST_PLAN_FILE}"),
    "next_txt": $(json_quote "${next_file}"),
    "llm_review": $(json_quote "${llm_review_file}"),
    "findings_yaml": $(json_quote "${findings_file}"),
    "result": $(json_quote "${REVIEW_RESULT_FILE}")
  }
}
EOF

  cat > "${REVIEW_RESULT_FILE}" <<EOF
{
  "schema_version": "v1",
  "review_pack": "OK",
  "pr_num": ${pr_num},
  "pr_remote": $(json_quote "${pr_remote}"),
  "artifacts_dir": $(json_quote "${REVIEW_ART_DIR}"),
  "manifest": $(json_quote "${REVIEW_MANIFEST_FILE}"),
  "risk_scan": $(json_quote "${REVIEW_RISK_SCAN_FILE}"),
  "pr_summary": $(json_quote "${REVIEW_PR_SUMMARY_FILE}"),
  "review_strategy": $(json_quote "${review_strategy_file}"),
  "test_plan": $(json_quote "${REVIEW_TEST_PLAN_FILE}"),
  "next_txt": $(json_quote "${next_file}"),
  "llm_review": $(json_quote "${llm_review_file}"),
  "findings_yaml": $(json_quote "${findings_file}"),
  "minimal_tests_hint": $(json_quote "${REVIEW_MIN_TESTS_HINT}")
}
EOF

  review_trace "finalize" "ok" "review pack completed" "{\"result\":$(json_quote "${REVIEW_RESULT_FILE}")}"
  REVIEW_STATUS="OK"
  rm -f \
    "${high_hits_file}" "${medium_hits_file}" "${low_hits_file}" \
    "${high_sorted_file}" "${medium_sorted_file}" "${low_sorted_file}" \
    "${hotspots_tmp_file}" "${must_tests_file}" "${optional_tests_file}" \
    "${findings_tmp_file}" "${findings_md_tmp_file}" || true
  return 0
}

open_worktree() {
  local branch="$1"
  [[ -n "${branch}" ]] || die "branch is required"

  local worktree="${WT_ROOT}/${branch}"
  local remote_branch="${DEFAULT_REMOTE}/${branch}"
  local base_ref="${DEFAULT_REMOTE}/${BASE_BRANCH}"

  info "repo=${REPO_ROOT}"
  info "worktree=${worktree}"
  info "branch=${branch}"
  info "remote_branch=${remote_branch}"

  run_cmd mkdir -p "${WT_ROOT}"
  run_cmd git -C "${REPO_ROOT}" fetch "${DEFAULT_REMOTE}" --prune

  if git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/remotes/${remote_branch}"; then
    run_cmd git -C "${REPO_ROOT}" branch -f "${branch}" "${remote_branch}"
  else
    local start_point="HEAD"
    if git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/remotes/${base_ref}"; then
      start_point="${base_ref}"
    elif git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/heads/${BASE_BRANCH}"; then
      start_point="${BASE_BRANCH}"
    fi
    run_cmd git -C "${REPO_ROOT}" branch -f "${branch}" "${start_point}"
    run_cmd git -C "${REPO_ROOT}" push -u "${DEFAULT_REMOTE}" "${branch}:${branch}"
  fi

  if [[ -d "${worktree}" ]]; then
    info "worktree exists: ${worktree}"
  else
    run_cmd git -C "${REPO_ROOT}" worktree add "${worktree}" "${branch}"
  fi
  ensure_worktree_dirs "${worktree}"

  if [[ "${WANT_CURSOR}" == "1" ]]; then
    exec_tool_cmd "${CURSOR_CMD}" "${worktree}"
  fi
  if [[ "${WANT_CODEX}" == "1" ]]; then
    exec_tool_cmd "${CODEX_CMD}" "${worktree}"
  fi
}

pr_worktree() {
  local pr_num="$1"
  [[ "${pr_num}" =~ ^[0-9]+$ ]] || die "prNum must be a number"

  local pr_remote="${PR_REMOTE:-origin}"
  local branch="pr-${pr_num}"
  local worktree="${WT_ROOT}/${branch}"
  local repo_norm worktree_norm occupied occupied_norm fetched_ref
  local switched_from_repo=0
  fetched_ref="refs/remotes/${pr_remote}/pr/${pr_num}"
  repo_norm="$(normalize_path "${REPO_ROOT}")"
  worktree_norm="$(normalize_path "${worktree}")"

  if [[ "${WANT_REVIEW}" != "1" ]]; then
    info "repo=${REPO_ROOT}"
    info "worktree=${worktree}"
    info "pr=${pr_num}"
    info "pr_remote=${pr_remote}"
  fi

  run_cmd mkdir -p "${WT_ROOT}"

  occupied="$(worktree_path_for_branch "${branch}" | head -n1 || true)"
  occupied_norm=""
  if [[ -n "${occupied}" ]]; then
    occupied_norm="$(normalize_path "${occupied}")"
  fi
  if [[ -n "${occupied_norm}" && "${occupied_norm}" != "${worktree_norm}" ]]; then
    if [[ "${occupied_norm}" == "${repo_norm}" ]]; then
      switch_repo_root_away_from_pr_branch "${branch}" "${pr_remote}"
      switched_from_repo=1
    else
      die "branch ${branch} is already checked out at ${occupied}"
    fi
  fi

  occupied="$(worktree_path_for_branch "${branch}" | head -n1 || true)"
  occupied_norm=""
  if [[ -n "${occupied}" ]]; then
    occupied_norm="$(normalize_path "${occupied}")"
  fi
  if [[ -n "${occupied_norm}" && "${occupied_norm}" != "${worktree_norm}" ]]; then
    if [[ "${DRY_RUN}" == "1" && "${switched_from_repo}" == "1" && "${occupied_norm}" == "${repo_norm}" ]]; then
      info "dry-run mode: assume root branch switch succeeded"
    else
      die "branch ${branch} is still checked out at ${occupied}"
    fi
  fi

  run_cmd git -C "${REPO_ROOT}" fetch "${pr_remote}" --prune
  run_cmd git -C "${REPO_ROOT}" fetch "${pr_remote}" "pull/${pr_num}/head:${fetched_ref}"

  if [[ "${occupied_norm}" != "${worktree_norm}" ]]; then
    if git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/heads/${branch}"; then
      run_cmd git -C "${REPO_ROOT}" branch -f "${branch}" "${fetched_ref}"
    else
      run_cmd git -C "${REPO_ROOT}" branch "${branch}" "${fetched_ref}"
    fi
  else
    info "branch ${branch} is already attached to target worktree; skip local branch reset"
  fi

  if [[ -d "${worktree}" ]]; then
    info "worktree exists: ${worktree}"
  else
    run_cmd git -C "${REPO_ROOT}" worktree add "${worktree}" "${branch}"
  fi
  ensure_worktree_dirs "${worktree}"

  if [[ "${WANT_REVIEW}" == "1" ]]; then
    if ! generate_review_pack "${pr_num}" "${pr_remote}" "${worktree}" "${branch}"; then
      REVIEW_STATUS="FAIL"
      print_review_stdout "FAIL"
      return 1
    fi
    print_review_stdout "OK"
  fi

  if [[ "${WANT_REVIEW}" == "1" ]]; then
    echo "CODEX_NEXT: run pr-review skill with ARTIFACTS_DIR=${REVIEW_ART_DIR}"
    echo "CODEX_NEXT_CMD: pr-review --artifacts-dir \"${REVIEW_ART_DIR}\""
  fi

  if [[ "${WANT_CURSOR}" == "1" ]]; then
    exec_tool_cmd "${CURSOR_CMD}" "${worktree}"
  fi
  if [[ "${WANT_CODEX}" == "1" ]]; then
    exec_tool_cmd "${CODEX_CMD}" "${worktree}"
  fi
}

parse_deconflict_flags() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --codex)
        WANT_CODEX=1
        ;;
      --push)
        DECONFLICT_PUSH=1
        ;;
      --head-owner)
        [[ $# -ge 2 ]] || die_usage "--head-owner requires a value"
        DECONFLICT_HEAD_OWNER="$2"
        shift
        ;;
      --head-repo)
        [[ $# -ge 2 ]] || die_usage "--head-repo requires a value"
        DECONFLICT_HEAD_REPO="$2"
        shift
        ;;
      --merge)
        [[ -z "${DECONFLICT_STRATEGY}" || "${DECONFLICT_STRATEGY}" == "merge" ]] || die_usage "--merge and --rebase cannot be used together"
        DECONFLICT_STRATEGY="merge"
        ;;
      --rebase)
        [[ -z "${DECONFLICT_STRATEGY}" || "${DECONFLICT_STRATEGY}" == "rebase" ]] || die_usage "--merge and --rebase cannot be used together"
        DECONFLICT_STRATEGY="rebase"
        ;;
      --no-fallback)
        DECONFLICT_NO_FALLBACK=1
        ;;
      --dry-run)
        DRY_RUN=1
        ;;
      -v)
        VERBOSE=1
        ;;
      *)
        die_usage "unknown flag: $1"
        ;;
    esac
    shift
  done

  if [[ -n "${DECONFLICT_HEAD_OWNER}" && ! "${DECONFLICT_HEAD_OWNER}" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]]; then
    die_usage "invalid --head-owner: ${DECONFLICT_HEAD_OWNER}"
  fi
  if [[ -n "${DECONFLICT_HEAD_REPO}" && ! "${DECONFLICT_HEAD_REPO}" =~ ^[^/]+/[^/]+$ ]]; then
    die_usage "invalid --head-repo: ${DECONFLICT_HEAD_REPO} (expect owner/repo)"
  fi
  if [[ "${DECONFLICT_PUSH}" == "1" && "${WANT_CODEX}" == "1" ]]; then
    die_usage "--codex is only valid for prepare phase (without --push)"
  fi
  if [[ "${DECONFLICT_PUSH}" != "1" && "${DECONFLICT_NO_FALLBACK}" == "1" ]]; then
    die_usage "--no-fallback is only valid with --push"
  fi
}

parse_flags() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --codex)
        WANT_CODEX=1
        ;;
      --cursor)
        WANT_CURSOR=1
        ;;
      --review)
        WANT_REVIEW=1
        REVIEW_FLAG_EXPLICIT=1
        ;;
      --codex-plan)
        WANT_CODEX_PLAN=1
        ;;
      --base)
        [[ $# -ge 2 ]] || die_usage "--base requires a value"
        BASE_OVERRIDE="$2"
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        ;;
      -v)
        VERBOSE=1
        ;;
      *)
        die_usage "unknown flag: $1"
        ;;
    esac
    shift
  done

  if [[ "${WANT_CODEX}" == "1" && "${WANT_CURSOR}" == "1" ]]; then
    die_usage "--codex and --cursor cannot be used together"
  fi
}

main() {
  WT_INVOCATION="$*"
  local cmd="${1:-}"
  if [[ -z "${cmd}" ]]; then
    usage
    exit 2
  fi

  case "${cmd}" in
    --version|-V|version)
      echo "wt ${VERSION}"
      exit 0
      ;;
    open)
      shift
      local branch="${1:-}"
      [[ -n "${branch}" ]] || die "open requires <branch>"
      shift || true
      parse_flags "$@"
      if [[ "${WANT_REVIEW}" == "1" || "${WANT_CODEX_PLAN}" == "1" || -n "${BASE_OVERRIDE}" ]]; then
        die_usage "--review/--codex-plan/--base are only valid for wt pr|review"
      fi
      need_cmd git
      load_config
      warn_if_noncanonical_entry
      open_worktree "${branch}"
      ;;
    pr)
      shift
      local pr_num="${1:-}"
      [[ -n "${pr_num}" ]] || die_usage "pr requires <prNum>"
      shift || true
      parse_flags "$@"
      if [[ "${WANT_REVIEW}" == "1" && "${DRY_RUN}" == "1" ]]; then
        die_usage "--dry-run is not supported with --review"
      fi
      if [[ "${WANT_CODEX_PLAN}" == "1" ]]; then
        echo "NOT_IMPLEMENTED: --codex-plan (use --codex)"
        exit 2
      fi
      need_cmd git
      load_config
      warn_if_noncanonical_entry
      pr_worktree "${pr_num}"
      ;;
    review)
      shift
      local pr_num="${1:-}"
      [[ -n "${pr_num}" ]] || die_usage "review requires <prNum>"
      shift || true
      WANT_REVIEW=1
      parse_flags "$@"
      if [[ "${REVIEW_FLAG_EXPLICIT}" == "1" ]]; then
        die_usage "--review is redundant for wt review"
      fi
      if [[ "${WANT_REVIEW}" == "1" && "${DRY_RUN}" == "1" ]]; then
        die_usage "--dry-run is not supported with --review"
      fi
      if [[ "${WANT_CODEX_PLAN}" == "1" ]]; then
        echo "NOT_IMPLEMENTED: --codex-plan (use --codex)"
        exit 2
      fi
      need_cmd git
      load_config
      warn_if_noncanonical_entry
      pr_worktree "${pr_num}"
      ;;
    deconflict)
      shift
      local pr_num="${1:-}"
      [[ -n "${pr_num}" ]] || die_usage "deconflict requires <prNum>"
      shift || true
      parse_deconflict_flags "$@"
      need_cmd git
      need_cmd gh
      load_config
      warn_if_noncanonical_entry
      deconflict_workflow "${pr_num}"
      ;;
    sync)
      shift || true
      parse_flags "$@"
      if [[ "${WANT_REVIEW}" == "1" || "${WANT_CODEX_PLAN}" == "1" || -n "${BASE_OVERRIDE}" || "${WANT_CODEX}" == "1" || "${WANT_CURSOR}" == "1" ]]; then
        die_usage "sync only supports [--dry-run] [-v]"
      fi
      need_cmd git
      load_config
      sync_entrypoints
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
