join_with() {
  local sep="$1"
  shift
  local out=""
  local item
  for item in "$@"; do
    if [[ -z "${out}" ]]; then
      out="${item}"
    else
      out="${out}${sep}${item}"
    fi
  done
  printf '%s' "${out}"
}

