launch_deconflict_codex() {
  local worktree="$1"
  local manual_cmd="cd ${worktree} && codex"
  local escaped_cmd=""
  local osa_output=""
  local osa_rc=0

  if [[ "${WANT_CODEX}" != "1" ]]; then
    return 0
  fi

  if [[ "${DRY_RUN}" == "1" ]]; then
    echo "[dry-run] codex launch for ${worktree}"
    echo "[dry-run] manual command: ${manual_cmd}"
    return 0
  fi

  if [[ ! -t 0 || ! -t 1 ]]; then
    warn_deconflict "codex auto-launch skipped: non-interactive terminal. Please run in iTerm/interactive terminal: ${manual_cmd}"
    info "codex auto-launch skipped (non-interactive terminal)."
    echo "[wt] run this in iTerm/interactive terminal:"
    echo "${manual_cmd}"
    return 0
  fi

  if [[ "${OSTYPE:-}" == darwin* ]] && command -v osascript >/dev/null 2>&1; then
    escaped_cmd="${manual_cmd//\\/\\\\}"
    escaped_cmd="${escaped_cmd//\"/\\\"}"
    set +e
    osa_output="$(osascript <<OSA 2>&1
tell application "iTerm"
  activate
  if (count of windows) = 0 then
    create window with default profile
  end if
  tell current window
    create tab with default profile
    tell current session
      write text "${escaped_cmd}"
    end tell
  end tell
end tell
OSA
)"
    osa_rc=$?
    set -e
    if [[ "${osa_rc}" == "0" ]]; then
      info "opened iTerm tab and started codex in ${worktree}"
      return 0
    fi
    warn_deconflict "failed to auto-open iTerm tab for codex: ${osa_output}"
  fi

  warn_deconflict "codex auto-launch fallback to manual command: ${manual_cmd}"
  info "codex auto-launch unavailable; run manually."
  echo "[wt] run this in iTerm/interactive terminal:"
  echo "${manual_cmd}"
  return 0
}
