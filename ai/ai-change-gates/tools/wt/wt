  if [[ "${script_norm}" != "${canonical_norm}" ]]; then
    echo "[wt][WARN] invoked via ${SCRIPT_PATH}" >&2
    echo "[wt][WARN] canonical entry is ${canonical}" >&2
    echo "[wt][WARN] run 'wt sync' to refresh local wrappers" >&2
  fi
